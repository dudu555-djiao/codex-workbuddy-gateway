# Personal desktop route: configure a real native worker conversation once.
# The installed persistent service starts/reconnects WorkBuddy when tasks arrive.
# Never fall back silently to a separate CLI host.
WORKBUDDY_BACKEND=desktop-queue
# Optional absolute Node path when desktop apps do not inherit your shell PATH.
# WORKBUDDY_NODE_BIN=/path/to/node
WORKBUDDY_CLI_PERMISSION_MODE=acceptEdits
# ACP-only setting. Queue uses existing native desktop permissions.
WORKBUDDY_ACP_PERMISSION_MODE=allow_once
# Legacy gateway-only settings. These are not used by desktop-queue and do not
# establish a visible desktop conversation.
# WORKBUDDY_GATEWAY_URL=http://127.0.0.1:64523
# WORKBUDDY_GATEWAY_PASSWORD=

# Optional paths if WorkBuddy is installed somewhere else.
# WORKBUDDY_CLI_ELECTRON=/Applications/WorkBuddy.app/Contents/MacOS/Electron
# WORKBUDDY_CLI_SCRIPT=/Applications/WorkBuddy.app/Contents/Resources/app.asar/cli/bin/codebuddy

# Official API route (requires an enabled Open Platform app, usually hardware/Buddy).
# Set WORKBUDDY_BACKEND=api to use these values.
WORKBUDDY_CLIENT_ID=
WORKBUDDY_CLIENT_SECRET=

# Optional: use an access token directly for a quick smoke test.
# WORKBUDDY_ACCESS_TOKEN=

# The Open API base URL. Keep the default unless WorkBuddy documents a change.
WORKBUDDY_API_BASE_URL=https://www.workbuddy.cn/openapi/v2

# Local token file. Keep it outside source control and chmod 600.
WORKBUDDY_TOKEN_FILE=./data/credentials.json

# Local task database.
WORKBUDDY_DB_FILE=./data/tasks.sqlite
# Private persistent session registration (normally installed automatically).
# WORKBUDDY_SERVICE_CONFIG=./data/persistent-service.json
# Private queue / ACP journals (optional; defaults beside the task DB).
# WORKBUDDY_RUNS_DIR=./data/runs
WORKBUDDY_TASK_TIMEOUT_SECONDS=1800

# OAuth callback must exactly match the URL registered in the WorkBuddy app.
WORKBUDDY_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback
WORKBUDDY_OAUTH_PORT=8787
WORKBUDDY_OAUTH_SCOPES='user.localassistant.invokable user.localassistant.readable'
